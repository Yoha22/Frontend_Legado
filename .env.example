#
# Variables de entorno — Legado Diover Ávila
#
# Copia este archivo a `.env.local` y rellena los valores.
# `.env.local` está en .gitignore: NUNCA subas claves al repositorio.
#

# ── Supabase ────────────────────────────────────────────────────────────────
# Panel de Supabase → Project Settings → API

# URL del proyecto. Pública, va al navegador.
NEXT_PUBLIC_SUPABASE_URL="https://xxxxxxxxxxxxxxxx.supabase.co"

# Clave anónima. Pública por diseño: solo puede leer lo que permite RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOi..."

# ⚠ SECRETA. Ignora RLS por completo: da acceso total a la base de datos y a
# los documentos de los menores. Solo se usa en Server Actions, nunca llega al
# navegador. Si se filtra, rótala de inmediato desde el panel de Supabase.
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOi..."

# ── Resend (correos transaccionales) ────────────────────────────────────────
# https://resend.com → API Keys

RESEND_API_KEY="re_xxxxxxxxxxxx"

# Remitente. El dominio debe estar verificado en Resend o los correos no salen.
# Para probar sin dominio propio se puede usar onboarding@resend.dev.
CORREO_REMITENTE="Legado Diover Ávila <inscripciones@legadodioveravila.com>"

# Destinatario de los avisos de nueva inscripción y de las propuestas de
# patrocinio. Si falta, la inscripción igual se guarda pero nadie se entera.
CORREO_ADMIN="direccion@legadodioveravila.com"

# ── Sitio ───────────────────────────────────────────────────────────────────

# Celular de WhatsApp de la escuela, con indicativo de país.
# Alimenta el botón flotante y la página de contacto.
NEXT_PUBLIC_WHATSAPP_NUMERO="+573000000000"

# URL pública. Se usa en metadatos Open Graph, sitemap.xml y robots.txt.
# En Vercel, ponla con el dominio definitivo (https, sin barra final).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
